# Copy to .env locally; use a secret manager in production. Never commit real values.
NODE_ENV=development
PORT=3000
# HTTPS origin of your deployed backend or developer tunnel; no path or trailing slash required.
APP_URL=https://replace-with-your-backend.example
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=unauthenticated_read_product_listings,read_pixels,write_pixels,read_customer_events,write_app_proxy
ALLOWED_SHOPS=ym5fhx-fa.myshopify.com
# Scoped runtime role, required in production. This role needs DML, never schema DDL.
# When unset in development, local PGlite initializes/migrates automatically.
DATABASE_URL=
# Migration job only: dedicated sales_agent schema owner. Never inject into runtime service.
MIGRATION_DATABASE_URL=
# Exact logical database name; verified before any migration DDL. Migration job only.
MIGRATION_EXPECTED_DATABASE=
# One-time isolated bootstrap only, after migration. Remove both after successful bootstrap.
RUNTIME_ROLE_BOOTSTRAP=false
# 32–256 independently generated random URL-safe ASCII characters; never a CLI argument.
RUNTIME_DATABASE_PASSWORD=
# Shared pilot instance defaults; pool range 1..10, timeout bounds documented in OPERATIONS.
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
# Two independently generated secrets. ENCRYPTION_KEY: 32 random bytes encoded as base64.
ENCRYPTION_KEY=
# At least 32 random characters.
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Optional second provider; required when an enabled experiment has a Mistral arm.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
